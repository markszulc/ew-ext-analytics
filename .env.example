ANALYTICS_CLIENT_ID=
ANALYTICS_CLIENT_SECRET=
ANALYTICS_SCOPES=openid,AdobeID,read_organizations,additional_info.projectedProductContext
ANALYTICS_COMPANY_ID=
ANALYTICS_REPORT_SUITE_ID=
ANALYTICS_REPORT_SUITE_NAME=Production website
# Required: use the exact IANA time zone configured for your report suite.
ANALYTICS_TIME_ZONE=UTC
# The dimension must contain the same exact path supplied by Workspace.
# Use an eVar here if pageName is not your content path.
ANALYTICS_PAGE_DIMENSION=variables/page
# Optional prefix, e.g. https://www.example.com when the dimension stores URLs.
ANALYTICS_PAGE_PREFIX=
PORT=3000
